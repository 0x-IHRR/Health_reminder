# Copy selected values to:
# ~/.config/HealthReminder/config.env
#
# Values are seconds unless the key says otherwise.

# Health reminders. Supported *_ENABLED values: true, false.
HEALTH_REMINDERS_ENABLED=true
# Supported values: screen_awake, input_active
HEALTH_REMINDER_COUNTING_MODE=screen_awake
HEALTH_REMINDER_IDS=rest,water,posture,medicine

HEALTH_REMINDER_REST_ENABLED=true
HEALTH_REMINDER_REST_TITLE=放松眼睛，活动一下
HEALTH_REMINDER_REST_BODY=看一下远处，站起来动一动。
HEALTH_REMINDER_REST_INTERVAL_SECONDS=1800

HEALTH_REMINDER_WATER_ENABLED=true
HEALTH_REMINDER_WATER_TITLE=喝水
HEALTH_REMINDER_WATER_BODY=喝几口水，别等口渴了再喝。
HEALTH_REMINDER_WATER_INTERVAL_SECONDS=3600

HEALTH_REMINDER_POSTURE_ENABLED=true
HEALTH_REMINDER_POSTURE_TITLE=调整坐姿，放松肩颈
HEALTH_REMINDER_POSTURE_BODY=坐直一点，转转脖子，活动一下肩膀。
HEALTH_REMINDER_POSTURE_INTERVAL_SECONDS=5400

HEALTH_REMINDER_MEDICINE_ENABLED=false
HEALTH_REMINDER_MEDICINE_TITLE=吃药
HEALTH_REMINDER_MEDICINE_BODY=按计划吃药，别漏掉。
HEALTH_REMINDER_MEDICINE_INTERVAL_SECONDS=14400

# Custom reminders use IDs such as custom_1, custom_2, custom_3.
# Add the ID to HEALTH_REMINDER_IDS, then define its fields:
# HEALTH_REMINDER_CUSTOM_1_ENABLED=true
# HEALTH_REMINDER_CUSTOM_1_TITLE=滴眼药水
# HEALTH_REMINDER_CUSTOM_1_BODY=按计划滴眼药水。
# HEALTH_REMINDER_CUSTOM_1_INTERVAL_SECONDS=2700

# Legacy interval keys are still read for compatibility, but the settings window writes HEALTH_REMINDER_* keys.
# HEALTH_MOVEMENT_INTERVAL_SECONDS=1800
# HEALTH_WATER_INTERVAL_SECONDS=3600
# HEALTH_POSTURE_INTERVAL_SECONDS=5400

FOCUS_REMINDER_INTERVAL_SECONDS=900
IDLE_THRESHOLD_SECONDS=60
TICK_INTERVAL_SECONDS=1

KANBAN_PATH=/Users/ihrr/Library/Mobile Documents/iCloud~md~obsidian/Documents/起源之地/0x.Start/_Meta/Kanban.md
# Leave KANBAN_INBOX_SECTION empty to read all unchecked tasks from the file.
KANBAN_INBOX_SECTION=收件箱

# Global overlay display duration. Supported range: 2-12 seconds.
OVERLAY_DISPLAY_SECONDS=4
OVERLAY_FADE_IN_SECONDS=0.35
OVERLAY_FADE_OUT_SECONDS=0.5
# Supported values: off, dim, dim_glow
OVERLAY_BACKDROP_STYLE=dim_glow
# Supported range: 0.2-0.9
OVERLAY_BACKDROP_OPACITY=0.8
OVERLAY_WIDTH=560
OVERLAY_HEIGHT=176
# Supported values: alert_yellow, dark_particle, light_particle
OVERLAY_THEME=alert_yellow
OVERLAY_TEXT_ALIGNMENT=center
# Supported values: classic, prism, aurora, warm
OVERLAY_TEXT_STYLE=classic
# Supported values: small, medium, large
OVERLAY_TEXT_SIZE=large
OVERLAY_POSITION=upper_center
OVERLAY_VERTICAL_OFFSET_RATIO=0.24

# Supported values: reconstruct, light, off
OVERLAY_PARTICLE_STYLE=reconstruct
OVERLAY_PARTICLE_COUNT=140
OVERLAY_PARTICLE_CANVAS_PADDING=220
OVERLAY_PARTICLE_BIRTH_RATE=72
OVERLAY_PARTICLE_LIFETIME_SECONDS=1.1
OVERLAY_PARTICLE_DURATION_SECONDS=0.85
OVERLAY_PARTICLE_VELOCITY=52
OVERLAY_PARTICLE_SCALE=0.03

# About page. Empty values are hidden in the app.
ABOUT_DEVELOPER_NAME=
ABOUT_WEBSITE_URL=
ABOUT_EMAIL=
ABOUT_GITHUB_URL=
ABOUT_COMMUNITY_URL=
ABOUT_FEEDBACK_URL=
