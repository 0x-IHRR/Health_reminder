# Copy selected values to:
# ~/.config/HealthReminder/config.env
#
# Values are seconds unless the key says otherwise.

HEALTH_MOVEMENT_INTERVAL_SECONDS=1800
HEALTH_WATER_INTERVAL_SECONDS=3600
HEALTH_POSTURE_INTERVAL_SECONDS=5400
FOCUS_REMINDER_INTERVAL_SECONDS=900
IDLE_THRESHOLD_SECONDS=60
TICK_INTERVAL_SECONDS=1

KANBAN_PATH=/Users/ihrr/Library/Mobile Documents/iCloud~md~obsidian/Documents/起源之地/0x.Start/_Meta/Kanban.md
KANBAN_INBOX_SECTION=收件箱

OVERLAY_DISPLAY_SECONDS=4
OVERLAY_FADE_IN_SECONDS=0.35
OVERLAY_FADE_OUT_SECONDS=0.5
OVERLAY_WIDTH=420
OVERLAY_HEIGHT=132
OVERLAY_THEME=dark_neon
OVERLAY_TEXT_ALIGNMENT=center

# Supported values: reconstruct, light, off
OVERLAY_PARTICLE_STYLE=reconstruct
OVERLAY_PARTICLE_BIRTH_RATE=72
OVERLAY_PARTICLE_LIFETIME_SECONDS=1.1
OVERLAY_PARTICLE_DURATION_SECONDS=0.85
OVERLAY_PARTICLE_VELOCITY=52
OVERLAY_PARTICLE_SCALE=0.03
